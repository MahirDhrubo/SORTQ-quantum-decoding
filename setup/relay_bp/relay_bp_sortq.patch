+/// MODIFIED (SORTQ): integer format "intN.S.M".
+/// Messages: sign + N bits, saturating to +/- msg_max. Priors: round(S * ln((1-p)/p)), saturated to messages.
+/// Memory: gamma rounded to the grid 1/M; bias = round(((M - g) * L0 + g * Mpost) / M), saturated to marginals.
+/// Marginals: two's complement, [marg_min, marg_max], saturating. round(x) = floor(x + 1/2) (half up).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct QuantFormat {
+    pub scale: f64,
+    pub msg_max: f64,
+    pub marg_min: f64,
+    pub marg_max: f64,
+    pub gamma_den: f64,
+}
+
+impl QuantFormat {
+    /// "none" -> None; "int4.2.8"; "int6.4.8"; "wide" (16-bit messages, S = 64, 20-bit marginals, M = 65536).
+    /// For intN.S.M the marginal width is N + 3 bits (two's complement).
+    pub fn parse(name: &str) -> Option<QuantFormat> {
+        match name {
+            "none" | "" => None,
+            "wide" => Some(QuantFormat {
+                scale: 64.,
+                msg_max: 32767.,
+                marg_min: -524288.,
+                marg_max: 524287.,
+                gamma_den: 65536.,
+            }),
+            _ => {
+                let parts: Vec<&str> = name
+                    .strip_prefix("int")
+                    .unwrap_or_else(|| panic!("unknown quant format {name}"))
+                    .split('.')
+                    .collect();
+                assert_eq!(parts.len(), 3, "quant format must be intN.S.M, got {name}");
+                let n: i32 = parts[0].parse().expect("N");
+                let s: f64 = parts[1].parse().expect("S");
+                let m: f64 = parts[2].parse().expect("M");
+                let mb = n + 3; // marginal bits incl. sign
+                Some(QuantFormat {
+                    scale: s,
+                    msg_max: (2f64.powi(n)) - 1.,
+                    marg_min: -(2f64.powi(mb - 1)),
+                    marg_max: 2f64.powi(mb - 1) - 1.,
+                    gamma_den: m,
+                })
+            }
+        }
+    }
+    #[inline]
+    pub fn round(x: f64) -> f64 {
+        (x + 0.5).floor()
+    }
+    /// Saturate to the message range; returns (value, clipped).
+    #[inline]
+    pub fn sat_msg(&self, x: f64) -> (f64, bool) {
+        if x > self.msg_max {
+            (self.msg_max, true)
+        } else if x < -self.msg_max {
+            (-self.msg_max, true)
+        } else {
+            (x, false)
+        }
+    }
+    /// Saturate to the marginal range; returns (value, clipped).
+    #[inline]
+    pub fn sat_marg(&self, x: f64) -> (f64, bool) {
+        if x > self.marg_max {
+            (self.marg_max, true)
+        } else if x < self.marg_min {
+            (self.marg_min, true)
+        } else {
+            (x, false)
+        }
+    }
+}
+
