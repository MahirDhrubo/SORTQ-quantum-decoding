+    leg: usize,
+    iter: usize,
+    layer: usize,
+}
+
+impl DumpState {
+    fn from_env() -> Option<std::sync::Arc<std::sync::Mutex<DumpState>>> {
+        let path = std::env::var("RELAY_DUMP").ok()?;
+        let legs_max = std::env::var("RELAY_DUMP_LEGS").ok().and_then(|s| s.parse().ok()).unwrap_or(2);
+        let f = std::fs::File::create(&path).unwrap_or_else(|e| panic!("RELAY_DUMP {path}: {e}"));
+        Some(std::sync::Arc::new(std::sync::Mutex::new(DumpState {
+            w: std::io::BufWriter::new(f),
+            legs_max,
+            leg: 0,
+            iter: 0,
+            layer: 0,
+        })))
+    }
+    fn active(&self) -> bool {
+        self.leg < self.legs_max
+    }
+    fn put(&mut self, b: &[u8]) {
+        use std::io::Write;
+        self.w.write_all(b).expect("dump write");
+    }
+    fn u8(&mut self, x: u8) {
+        self.put(&[x]);
+    }
+    fn i8(&mut self, x: f64) {
+        assert!(x == x.round() && (-128.0..=127.0).contains(&x), "dump: value {x} is not an i8 integer");
+        self.put(&[(x as i8) as u8]);
+    }
+    fn u32(&mut self, x: usize) {
+        self.put(&(x as u32).to_le_bytes());
+    }
 }
 
